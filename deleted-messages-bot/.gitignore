# База с сохранёнными сообщениями и скачанные файлы — это личные данные
# чатов, им не место в репозитории.
data/
logs/

# Сессия Telethon даёт полный доступ к аккаунту: утечка файла равна утечке
# пароля вместе со вторым фактором.
*.session
*.session-journal

.venv/

# Кэш pytest: пересобирается сам, в истории от него один шум.
.pytest_cache/
