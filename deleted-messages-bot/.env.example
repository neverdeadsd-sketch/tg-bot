# Токен бота от @BotFather.
BOT_TOKEN=123456:AA...

# Куда присылать удалённые сообщения: id приватного канала или группы, куда
# добавлен бот. Отрицательное число. Узнать id: добавьте бота и отправьте /id.
ARCHIVE_CHAT_ID=-1001234567890

# Ваш Telegram id — через запятую, если нужно несколько. Пока список пуст,
# бот не отвечает на команды никому.
ADMIN_IDS=123456789

# --- необязательное, значения по умолчанию ---

# Куда класть базу и скачанные вложения.
DATA_DIR=data

# Скачивать вложения сразу (true) или хранить только ссылку file_id (false).
DOWNLOAD_MEDIA=true
MAX_DOWNLOAD_MB=20

# Сколько часов следить за сообщением и как часто опрашивать Telegram.
WATCH_HOURS=48
PROBE_RATE=2.0
PROBE_BATCH=40

# Сколько дней хранить архив. 0 — хранить всё.
KEEP_DAYS=0

# Архивировать служебные сообщения вида «вошёл в группу».
ARCHIVE_SERVICE_MESSAGES=false

# Ограничить архив списком чатов / исключить чаты. Пусто — все чаты, куда
# добавлен бот.
WATCH_CHATS=
IGNORE_CHATS=

# --- режим 2: userbot.py, ловит удаления мгновенно ---
# Создаётся на my.telegram.org -> API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
