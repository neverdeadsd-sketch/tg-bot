# Адреса подписок панелей. Файл кладётся в /root/.merge_sub.env
# с правами 600 и в репозиторий не попадает: в путях ключи.
#
#   sudo cp merge_sub.env.example /root/.merge_sub.env
#   sudo chmod 600 /root/.merge_sub.env
#   sudo nano /root/.merge_sub.env
#
# Адреса возьмите из прежнего /root/merge_sub.sh — это две строки curl.

NL_URL=https://АДРЕС/ПУТЬ/UUID/
FI_URL=https://АДРЕС/ПУТЬ/UUID/

# Как узлы будут называться в клиенте.
NL_NAME=🇳🇱 Нидерланды
FI_NAME=🇫🇮 Финляндия

# Панель по IP отдаёт сертификат не на этот адрес — тогда 1.
INSECURE=1
