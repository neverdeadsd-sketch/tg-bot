node_modules/
dist/
coverage/
*.tsbuildinfo
.env
.env.local
npm-debug.log*

# Локальные секреты и кэш wrangler для Worker.
# .dev.vars — то же, что .env, но для `wrangler dev`: в репозиторий ему нельзя.
.dev.vars
.wrangler/

# Скомпилированный python: пересобирается сам при каждом запуске тестов,
# и каждый запуск даёт другой файл. В истории от него один шум.
__pycache__/
*.pyc
