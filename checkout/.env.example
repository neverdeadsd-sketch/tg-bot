# --- ЮKassa ------------------------------------------------------------------
# Идентификатор магазина — не секрет, его видно в платёжной форме.
YOOKASSA_SHOP_ID=139865

# Секретный ключ. Даёт полный доступ к магазину: только здесь, никогда
# в репозитории, в логах и во фронтенде.
YOOKASSA_SECRET_KEY=

# --- Сайт --------------------------------------------------------------------
# Origin сайта. Из него собирается адрес возврата после оплаты,
# и он же единственный источник, которому разрешён CORS.
PUBLIC_URL=https://hollvpn.online

# --- Выдача подписки ---------------------------------------------------------
# Куда сообщить об оплате, чтобы выдать доступ. Без неё сервис не стартует:
# чекаут, умеющий взять деньги и не умеющий выдать подписку, — это способ
# собрать оплаты и не оказать услугу.
#
# Получает POST с JSON:
#   { order_id, payment_id, telegram, days, amount_kopecks, currency, paid_at }
# Ответ 2xx = подписка выдана. Любой другой — сервис повторит четыре раза,
# затем пометит заказ как требующий ручной выдачи.
FULFILMENT_URL=https://bot.hollvpn.online/internal/fulfil
FULFILMENT_TOKEN=

# --- Прочее ------------------------------------------------------------------
PORT=8080
DB_PATH=./orders.db

# Чек. У самозанятого чек формируется в «Мой налог», а не в ЮKassa,
# поэтому по умолчанию выключено. Включать, только если магазин
# действительно настроен на передачу чеков через ЮKassa.
SEND_RECEIPT=false
RECEIPT_EMAIL_REQUIRED=false

# Проверка адреса источника вебхука. Выключать только при локальной отладке.
VERIFY_WEBHOOK_IP=true

# Включите, если сервис стоит за nginx. Иначе он увидит адрес прокси вместо
# адреса ЮKassa и отклонит все настоящие уведомления. Заголовку X-Real-IP
# верим только при этом флаге — иначе его подделает кто угодно.
TRUST_PROXY=true
