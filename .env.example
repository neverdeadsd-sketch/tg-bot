# Токен бота от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Telegram ID администратора. Несколько — через запятую: 111111,222222
# Свой ID можно узнать у @userinfobot
ADMIN_ID=123456789

# Путь к файлу SQLite (относительный путь считается от корня проекта)
DB_PATH=data/bot.db

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Антиспам: сколько заявок принимаем с одного user_id за 24 часа
MAX_ORDERS_PER_DAY=3

# Троттлинг: минимальный интервал между событиями от одного пользователя, сек
THROTTLE_CALLBACK=0.4
THROTTLE_MESSAGE=0.5

# Таймаут HTTP-запросов к Telegram API, сек
REQUEST_TIMEOUT=60

# Сколько заявок показывать на странице /orders
ORDERS_PAGE_SIZE=10
