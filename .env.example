# Get api_id / api_hash at https://my.telegram.org -> API development tools
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef

# Optional: phone number for non-interactive first login (+79990000000)
TG_PHONE=

# Path to the Telethon session file (without the .session extension)
TG_SESSION=sessions/tgnames

# Path to the local SQLite database
TGNAMES_DB=data/tgnames.db
