# ===================== Обязательное =====================

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Твой числовой Telegram ID (узнать у @userinfobot). Бот слушается только его.
ADMIN_CHAT_ID=

# paper — виртуальные SOL по реальным ценам (начни с этого!)
# live  — реальные сделки с кошелька ниже
TRADING_MODE=paper

# true — покупает сам; false — присылает сигнал с кнопкой «Купить»
AUTO_BUY=true

# ===================== Для режима live =====================

# Приватный ключ ОТДЕЛЬНОГО кошелька только для бота (base58 из Phantom → Export Private Key,
# или JSON-массив из solana-keygen). Никогда не основной кошелёк и не сид-фраза.
WALLET_PRIVATE_KEY=

# RPC Solana. Публичный работает, но медленный и с лимитами.
# Лучше бесплатный ключ Helius: https://mainnet.helius-rpc.com/?api-key=ТВОЙ_КЛЮЧ
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Бесплатный ключ Jupiter с https://portal.jup.ag (без ключа используется lite-api)
JUPITER_API_KEY=
# JUPITER_API_URL=https://api.jup.ag/swap/v1

# ===================== Деньги и риск =====================

BUY_AMOUNT_SOL=0.05            # сколько SOL на одну покупку
MAX_OPEN_POSITIONS=3           # одновременно открытых позиций
MAX_BUYS_PER_SCAN=1            # покупок за один проход поиска
MAX_DAILY_LOSS_SOL=0.15        # убыток за день (UTC), после которого новых покупок нет до завтра
MAX_TOTAL_LOSS_SOL=0.5         # общий убыток, после которого бот встаёт на паузу до /resume
MIN_SOL_RESERVE=0.03           # всегда оставлять на комиссии
BUY_SLIPPAGE_BPS=300           # 300 = 3%
SELL_SLIPPAGE_BPS=800          # 800 = 8% (на продаже выше, чтобы точно выйти при падении)
PRIORITY_FEE_MAX_LAMPORTS=300000   # максимум приоритетной комиссии за сделку (0.0003 SOL)
PRIORITY_LEVEL=high            # medium | high | veryHigh

# Бумажный режим
PAPER_START_SOL=1.0
PAPER_FEE_LAMPORTS=100000      # условная комиссия сети за сделку
PAPER_EXTRA_SLIPPAGE_PCT=1.0   # ухудшение цены, чтобы бумага не была лучше реальности

# ===================== Фильтры отбора =====================

MIN_LIQUIDITY_USD=50000
MIN_VOLUME_H24_USD=150000
MIN_MCAP_USD=500000
MAX_MCAP_USD=30000000
MIN_PAIR_AGE_HOURS=12          # не трогать совсем свежие запуски
MAX_PAIR_AGE_HOURS=720
MIN_TXNS_H1=100
MIN_BUY_SELL_RATIO_H1=1.1
MIN_PRICE_CHANGE_H1=3          # нужен рост за час…
MAX_PRICE_CHANGE_H1=60         # …но не вертикальный памп
MIN_PRICE_CHANGE_M5=-3         # не покупать, пока падает прямо сейчас
MAX_RUGCHECK_SCORE=30          # оценка риска RugCheck (0–100, меньше — лучше)
MIN_LP_LOCKED_PCT=90           # % заблокированной/сожжённой ликвидности
ALLOW_TOKEN2022=false
MAX_ROUNDTRIP_LOSS_PCT=6       # сколько можно потерять на «купить и сразу продать»

# ===================== Выход из позиции =====================

STOP_LOSS_PCT=25
TAKE_PROFIT_PCT=100            # на +100%…
TAKE_PROFIT_SELL_FRACTION=0.5  # …продать половину (вернуть вложенное)
TRAILING_ACTIVATE_PCT=30       # трейлинг включается после +30%…
TRAILING_STOP_PCT=20           # …и продаёт всё при откате на 20% от пика
MAX_HOLD_HOURS=24

# ===================== Служебное =====================

SCAN_INTERVAL_SEC=60
MONITOR_INTERVAL_SEC=15
DEEP_CHECKS_PER_SCAN=5
REJECT_COOLDOWN_MIN=20
RUG_REJECT_COOLDOWN_MIN=180
REBUY_COOLDOWN_HOURS=24
DATABASE_PATH=data/memebot.db
