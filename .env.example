# Application
PORT=3000
NODE_ENV=development

# Postgres used by the app. docker-compose.yml starts a matching instance.
DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet

# Separate database for the test suite. Tests TRUNCATE tables between cases,
# so never point this at a database you care about.
TEST_DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet_test

# Shared secret used to verify provider webhook signatures (HMAC-SHA256).
PROVIDER_WEBHOOK_SECRET=dev-secret-change-me
