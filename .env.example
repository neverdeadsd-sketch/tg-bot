# ===================== Обязательное =====================

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Твой числовой Telegram ID (узнать у @userinfobot). Бот слушается только его.
ADMIN_CHAT_ID=

# paper — виртуальные SOL по реальным ценам (начни с этого!)
# live  — реальные сделки с кошелька ниже
TRADING_MODE=paper

# true — покупает сам; false — присылает сигнал с кнопкой «Купить»
AUTO_BUY=true

# ===================== Для режима live =====================

# Приватный ключ ОТДЕЛЬНОГО кошелька только для бота (base58 из Phantom → Export Private Key,
# или JSON-массив из solana-keygen). Никогда не основной кошелёк и не сид-фраза.
WALLET_PRIVATE_KEY=

# RPC Solana. Публичный работает, но медленный и с лимитами.
# Лучше бесплатный ключ Helius: https://mainnet.helius-rpc.com/?api-key=ТВОЙ_КЛЮЧ
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Бесплатный ключ Jupiter с https://portal.jup.ag (без ключа используется lite-api)
JUPITER_API_KEY=
# JUPITER_API_URL=https://api.jup.ag/swap/v1

# ===================== Деньги и риск =====================

# сколько SOL на одну покупку
BUY_AMOUNT_SOL=0.05
# одновременно открытых позиций
MAX_OPEN_POSITIONS=3
# покупок за один проход поиска
MAX_BUYS_PER_SCAN=1
# убыток за день (UTC), после которого новых покупок нет до завтра
MAX_DAILY_LOSS_SOL=0.15
# общий убыток, после которого бот встаёт на паузу до /resume
MAX_TOTAL_LOSS_SOL=0.5
# всегда оставлять на комиссии
MIN_SOL_RESERVE=0.03
# 300 = 3%
BUY_SLIPPAGE_BPS=300
# 800 = 8% (на продаже выше, чтобы точно выйти при падении)
SELL_SLIPPAGE_BPS=800
# максимум приоритетной комиссии за сделку (0.0003 SOL)
PRIORITY_FEE_MAX_LAMPORTS=300000
# medium | high | veryHigh
PRIORITY_LEVEL=high

# Бумажный режим
PAPER_START_SOL=1.0
# условная комиссия сети за сделку
PAPER_FEE_LAMPORTS=100000
# ухудшение цены, чтобы бумага не была лучше реальности
PAPER_EXTRA_SLIPPAGE_PCT=1.0

# ===================== Фильтры отбора =====================

MIN_LIQUIDITY_USD=50000
MIN_VOLUME_H24_USD=150000
MIN_MCAP_USD=500000
MAX_MCAP_USD=30000000
# не трогать совсем свежие запуски
MIN_PAIR_AGE_HOURS=12
MAX_PAIR_AGE_HOURS=720
MIN_TXNS_H1=100
MIN_BUY_SELL_RATIO_H1=1.1
# нужен рост за час…
MIN_PRICE_CHANGE_H1=3
# …но не вертикальный памп
MAX_PRICE_CHANGE_H1=60
# не покупать, пока падает прямо сейчас
MIN_PRICE_CHANGE_M5=-3
# оценка риска RugCheck (0–100, меньше — лучше)
MAX_RUGCHECK_SCORE=30
# % заблокированной/сожжённой ликвидности
MIN_LP_LOCKED_PCT=90
ALLOW_TOKEN2022=false
# сколько можно потерять на «купить и сразу продать»
MAX_ROUNDTRIP_LOSS_PCT=6

# ===================== Выход из позиции =====================

STOP_LOSS_PCT=25
# на +100%…
TAKE_PROFIT_PCT=100
# …продать половину (вернуть вложенное)
TAKE_PROFIT_SELL_FRACTION=0.5
# трейлинг включается после +30%…
TRAILING_ACTIVATE_PCT=30
# …и продаёт всё при откате на 20% от пика
TRAILING_STOP_PCT=20
MAX_HOLD_HOURS=24

# ===================== Служебное =====================

SCAN_INTERVAL_SEC=60
MONITOR_INTERVAL_SEC=15
DEEP_CHECKS_PER_SCAN=5
REJECT_COOLDOWN_MIN=20
RUG_REJECT_COOLDOWN_MIN=180
REBUY_COOLDOWN_HOURS=24
DATABASE_PATH=data/memebot.db
